# FreeBatch Studio - environment configuration
#
# Copy this file to `.env` and fill in your keys.
# `.env` is git-ignored and NEVER committed.

# Agnes AI API key (free, create at https://platform.agnes-ai.com/settings/apiKeys)
AGNES_API_KEY=

# AI Horde API key. Leave empty to use anonymous mode (key "0000000000").
# Anonymous requests have the lowest queue priority.
AI_HORDE_API_KEY=

# --- Server ---
# Bind only to localhost by default. Do NOT expose to the LAN unless you
# understand the security implications.
HOST=127.0.0.1
PORT=8737

# --- Application behavior ---
# FREE_ONLY_MODE=true refuses any provider that is not verified as free.
FREE_ONLY_MODE=true

# Where outputs, database and logs live
DATA_DIR=data
OUTPUT_DIR=data/outputs
LOGS_DIR=logs

# --- Tuning ---
# Video/remote-task poll interval in seconds
POLL_INTERVAL_SECONDS=15
# Maximum attempts per job before it is marked failed
MAX_ATTEMPTS=3
# Per-request timeout for provider calls (seconds)
REQUEST_TIMEOUT_SECONDS=300
# Timeout for streaming downloads (seconds)
DOWNLOAD_TIMEOUT_SECONDS=300
# Maximum size of a single downloaded output (MB)
MAX_DOWNLOAD_SIZE_MB=2048
# Maximum size of a single remote reference image (MB)
MAX_REFERENCE_SIZE_MB=50

# --- Free-pricing safety ---
# Warn when pricing metadata is older than this many days
PRICING_STALE_DAYS=14
# Batches larger than this many jobs require acknowledging a stale-pricing warning
LARGE_BATCH_WARN_THRESHOLD=50

# --- Logging ---
LOG_LEVEL=INFO